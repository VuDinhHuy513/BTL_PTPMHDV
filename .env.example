# Dùng SQLite để chạy thử ngay, không cần cài gì
DATABASE_URL=sqlite:///./hotel_pms.db

# Dùng PostgreSQL (khuyến nghị cho đồ án)
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/hotel_pms

JWT_SECRET=doi-chuoi-nay-thanh-mot-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Quy tắc nghiệp vụ — đây là ví dụ điển hình của "đừng hard-code"
VAT_RATE=0.08
